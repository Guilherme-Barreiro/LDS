### Windows ###
# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

### DotnetCore ###
# Ignores files and folders generated by the dotnet CLI
/bin/
/obj/
.nuget/
# If you publishing somewhere else, you might want to ignore the publish folder
# /publish/

# Ignoring particular packages is not a good practice.
# NuGet packages are restored during the build and it will be best to have the same versions defined in the project file
# /packages/

# Transformed web.config files generated by the dotnet CLI
**/App.config
**/Web.config

# App settings files that are not checked in
appsettings.Development.json
appsettings.*.json

# User secrets
secrets.json

# User-specific files generated by the dotnet CLI
*.user
*.userosscache
*.suo

### SQLServer ###
# SQL Server files
*.mdf
*.ldf
*.ndf

# SQL Server backup files
*.bak
*.trn

# SQL Server trace files
*.trc

