<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <!-- O nome é sensível: tem de ser "XPlat code coverage" -->
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- formato que o ReportGenerator lê bem -->
          <Format>cobertura</Format>

          <!-- Excluir por ficheiro (globs no caminho) -->
          <ExcludeByFile>
            **/Migrations/*.cs;
            **/*DbContextModelSnapshot.cs;
            **/*ApplicationDbContextFactory.cs;
            **/*Program.cs;
            **/ConsultaPlus.API/DTOs/**/*.cs;
            **/ConsultaPlus.Core/Models/**/*.cs
          </ExcludeByFile>

          <!-- Excluir por assembly/tipo/namespace -->
          <!-- Sintaxe: [Assembly]TipoOuNamespaceComWildcard -->
          <Exclude>
            [ConsultaPlus.Infrastructure]*Repository*
            [ConsultaPlus.Infrastructure]*UoW*
            [ConsultaPlus.API]*Program*
          </Exclude>

          <!-- Incluir só os teus assemblies de app -->
          <Include>
            [ConsultaPlus.API]*
            [ConsultaPlus.Infrastructure]*
            [ConsultaPlus.Core]*
          </Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
