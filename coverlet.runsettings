<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CollectFromChildProcesses>true</CollectFromChildProcesses>

          <ExcludeByFile>**/Migrations/*.cs;**/*DbContextModelSnapshot.cs;**/*ApplicationDbContextFactory.cs;**/*Program.cs;**/ConsultaPlus.API/DTOs/**/*.cs;**/ConsultaPlus.Core/Models/**/*.cs</ExcludeByFile>

          <Exclude>[ConsultaPlus.Infrastructure]ConsultaPlus.Infrastructure.Repositories.*,[ConsultaPlus.Infrastructure]ConsultaPlus.Infrastructure.UoW.*,[ConsultaPlus.API]ConsultaPlus.API.Program</Exclude>

          <Include>[ConsultaPlus.API]*,[ConsultaPlus.Infrastructure]*,[ConsultaPlus.Core]*</Include>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
