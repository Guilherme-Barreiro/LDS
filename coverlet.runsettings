<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Excluir por ficheiro -->
          <ExcludeByFile>
            **/Migrations/*.cs;
            **/*DbContextModelSnapshot.cs;
            **/*ApplicationDbContextFactory.cs;
            **/*Program.cs;
            **/ConsultaPlus.API/DTOs/**/*.cs;
            **/ConsultaPlus.Core/Models/**/*.cs
          </ExcludeByFile>

          <!-- EXCLUIR por assembly + namespace COMPLETO -->
          <Exclude>
            [ConsultaPlus.Infrastructure]ConsultaPlus.Infrastructure.Repositories.*
            [ConsultaPlus.Infrastructure]ConsultaPlus.Infrastructure.UoW.*
            [ConsultaPlus.API]ConsultaPlus.API.Program
          </Exclude>

          <!-- Assemblies a incluir -->
          <Include>
            [ConsultaPlus.API]*
            [ConsultaPlus.Infrastructure]*
            [ConsultaPlus.Core]*
          </Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
