<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Excluir por ficheiro (paths glob) -->
          <ExcludeByFile>
            **/ConsultaPlus.API/DTOs/**/*.cs;
            **/ConsultaPlus.Core/Models/**/*.cs;
            **/Migrations/**/*.cs;
            **/Program.cs
          </ExcludeByFile>

          <!-- Excluir por assembly/namespace -->
          <!-- Sintaxe: [Assembly]Namespace.Class -->
          <Exclude>
            [ConsultaPlus.API]ConsultaPlus.API.DTOs.*;
            [ConsultaPlus.Core]ConsultaPlus.Core.Models.*;
          </Exclude>

          <!-- Opcional: apenas os teus assemblies de app -->
          <Include>[ConsultaPlus.*]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
